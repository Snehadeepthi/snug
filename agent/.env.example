# Copy to .env and fill in. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=snug-hack-2026
GOOGLE_CLOUD_LOCATION=global

# Copy the current Gemini Flash model ID from Model Garden in the Google Cloud console
SNUG_MODEL=REPLACE_WITH_FLASH_MODEL_ID
# Optional: a Pro model for the Catalogue Agent (reading size charts). Leave empty to use SNUG_MODEL.
SNUG_MODEL_PRO=

# local = in-memory demo data (no setup); firestore = Google Cloud Firestore
SNUG_BACKEND=local

# 1 = also serve the ADK developer UI at /dev-ui/ (great for debugging and as a backup demo)
SNUG_DEV_UI=1

# Extra web origins allowed to call the API (only needed if the web app is hosted elsewhere)
SNUG_ALLOWED_ORIGINS=http://localhost:5173
